########################################
# Database                              #
########################################
# Local dev (recommended, zero-install): run `npx prisma dev` from /api in a
# separate terminal — it starts a local Postgres-compatible dev server and
# prints a DATABASE_URL and a SHADOW_DATABASE_URL. Copy both here; they
# default to these connection strings on this machine:
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:51215/template1?sslmode=disable&connection_limit=10&connect_timeout=0&max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0"

# Local dev, option B: a real local/hosted Postgres instead of `prisma dev`:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wedding_automation?schema=public"
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/wedding_automation_shadow?schema=public"

# PRODUCTION (Railway): add a PostgreSQL plugin to the project — it injects
# DATABASE_URL automatically; you don't set it by hand. SHADOW_DATABASE_URL
# is NOT needed in production — it's only used by `prisma migrate dev`
# (dev-only, for diffing schema changes). Production runs
# `prisma migrate deploy` instead (see package.json's "start" script), which
# just applies committed migrations and never needs a shadow database.

########################################
# Server                                #
########################################
# Local dev only. Railway sets its own PORT at runtime — don't set this in
# the Railway dashboard, the app already reads process.env.PORT.
PORT=4000

########################################
# Authentication                        #
########################################
# Signs/verifies session JWTs. Use a long random string — e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Changing this invalidates every existing session (everyone gets logged out).
JWT_SECRET=""

# Only used by `npm run seed`, to set the password for the initial owner
# login (nazishashraf3@gmail.com). Set this in your shell/CI before running
# the seed script — never hardcode a real password in seed.ts or commit one.
# The seed is safe to re-run: if this is unset, it just skips creating the
# owner user instead of failing.
OWNER_SEED_PASSWORD=""

########################################
# File storage (Vercel Blob)            #
########################################
# From the Vercel dashboard: Storage -> Blob -> a store -> ".env.local" tab,
# or `vercel blob store create` / `vercel env pull`. Used to upload/delete
# wedding documents (see src/documents.ts) — a read/write token works
# perfectly fine from a non-Vercel server like this one.
BLOB_READ_WRITE_TOKEN=""

########################################
# Google Calendar integration           #
########################################
# From a Google Cloud Console project with the Google Calendar API enabled
# and an OAuth 2.0 Client ID (type: Web application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must exactly match an "Authorized redirect URI" configured on that OAuth
# client in Google Cloud Console. Since the frontend proxies /api/* through
# to this server (see web/next.config.mjs — needed so the session cookie is
# same-origin), Google redirects the browser back through that same proxy
# path, not directly to this server's own domain.
# Local dev:   http://localhost:4000/auth/google/callback
# Production:  https://<your-vercel-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"

########################################
# Frontend URL                          #
########################################
# Does two jobs: (1) where the browser is redirected after the Google OAuth
# flow finishes, and (2) the API's CORS allowed origin — requests from any
# other origin are rejected (see src/index.ts).
# Local dev:   http://localhost:3000
# Production:  your Vercel deployment URL, e.g. https://your-app.vercel.app
FRONTEND_URL="http://localhost:3000"

########################################
# Email automation (Resend)             #
########################################
# From https://resend.com — API Keys page. The free tier is enough for this.
RESEND_API_KEY=""
# Must be a verified sender. onboarding@resend.dev works for local testing
# (only delivers to the email address you signed up to Resend with). In
# production, verify your own domain in Resend and use an address on it so
# you can actually email clients/vendors.
FROM_EMAIL="onboarding@resend.dev"
