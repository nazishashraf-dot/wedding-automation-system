// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  lead
  active
  completed
  archived
}

enum PlanningStatus {
  inquiry
  booked
  in_progress
  final_month
  completed
}

enum VendorCategory {
  florist
  caterer
  venue
  photographer
  dj_band
  hair_makeup
  other
}

enum VendorLinkStatus {
  contacted
  quoted
  confirmed
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskSource {
  auto_generated
  manual
}

enum CalendarEventType {
  milestone
  client_meeting
  vendor_meeting
  reminder
}

enum EmailStatus {
  sent
  failed
}

enum PaymentDirection {
  incoming
  outgoing
}

enum PaymentStatus {
  pending
  paid
}

enum Role {
  owner
  assistant
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(assistant)
  createdAt    DateTime @default(now())

  documents    Document[]

  @@map("users")
}

// Wedding-scoped files (contracts, mood boards, floor plans, ...) — the
// actual bytes live in Vercel Blob; this row is just the metadata + URL.
model Document {
  id            String   @id @default(uuid())
  weddingId     String
  wedding       Wedding  @relation(fields: [weddingId], references: [id])
  fileName      String
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  uploadedById  String
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime @default(now())

  @@map("documents")
}

model Client {
  id           String       @id @default(uuid())
  fullName     String
  partnerName  String?
  email        String
  phone        String?
  status       ClientStatus @default(lead)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  weddings     Wedding[]

  @@map("clients")
}

model Wedding {
  id              String         @id @default(uuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  weddingDate     DateTime
  venue           String?
  budgetTotal     Decimal?       @db.Decimal(12, 2)
  budgetSpent     Decimal        @default(0) @db.Decimal(12, 2)
  planningStatus  PlanningStatus @default(inquiry)
  styleNotes      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Captured via the public client intake form (/forms/intake/[weddingId])
  guestCountEstimate Int?
  intakeNotes        String?

  vendors         WeddingVendor[]
  tasks           Task[]
  calendarEvents  CalendarEvent[]
  emailLogs       EmailLog[]
  documents       Document[]
  payments        Payment[]

  @@map("weddings")
}

model Vendor {
  id           String         @id @default(uuid())
  name         String
  category     VendorCategory
  contactEmail String?
  phone        String?
  notes        String?
  createdAt    DateTime       @default(now())

  weddings     WeddingVendor[]
  payments     Payment[]

  @@map("vendors")
}

model WeddingVendor {
  weddingId    String
  wedding      Wedding           @relation(fields: [weddingId], references: [id])
  vendorId     String
  vendor       Vendor            @relation(fields: [vendorId], references: [id])
  status       VendorLinkStatus  @default(contacted)
  priceQuoted  Decimal?          @db.Decimal(12, 2)
  notes        String?

  @@id([weddingId, vendorId])
  @@map("wedding_vendors")
}

model Task {
  id              String        @id @default(uuid())
  weddingId       String
  wedding         Wedding       @relation(fields: [weddingId], references: [id])
  timelineRuleId  String?
  timelineRule    TimelineRule? @relation(fields: [timelineRuleId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  dueDate         DateTime
  status          TaskStatus    @default(todo)
  priority        TaskPriority  @default(medium)
  assignee        String?
  source          TaskSource    @default(manual)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  calendarEvents  CalendarEvent[]
  emailLogs       EmailLog[]

  @@map("tasks")
}

// Configurable template of standard milestones. Editable without touching
// application code — this is what POST /weddings and the regenerate-timeline
// endpoint read from to auto-generate a wedding's task list.
model TimelineRule {
  id                  String       @id @default(uuid())
  label               String
  monthsBeforeWedding Int?
  weeksBeforeWedding  Int?
  taskTitle           String
  taskDescription     String?
  defaultPriority     TaskPriority @default(medium)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())

  // When true, generated tasks for this rule also get a Google Calendar
  // event (see src/timeline.ts + src/googleCalendar.ts). Most routine prep
  // tasks don't warrant a calendar entry — this is reserved for hard
  // deadlines and actual meetings.
  createsCalendarEvent Boolean            @default(false)
  calendarEventType    CalendarEventType?

  tasks               Task[]

  @@map("timeline_rules")
}

// Single-row table holding the OAuth refresh token for the one internal user
// who connects Google Calendar, plus the ID of the dedicated "Weddings"
// calendar we create on first use.
model GoogleAuthToken {
  id           String    @id @default(uuid())
  refreshToken String
  accessToken  String?
  expiryDate   DateTime?
  scope        String?
  calendarId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("google_auth_tokens")
}

model CalendarEvent {
  id            String            @id @default(uuid())
  weddingId     String
  wedding       Wedding           @relation(fields: [weddingId], references: [id])
  taskId        String?
  task          Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type          CalendarEventType
  title         String
  scheduledAt   DateTime
  googleEventId String?
  createdAt     DateTime          @default(now())

  @@map("calendar_events")
}

// Editable library of email templates, keyed by a stable slug rather than
// id so the email job / manual-send endpoint can reference a template by
// name without caring about its row id.
model EmailTemplate {
  id           String   @id @default(uuid())
  key          String   @unique
  subject      String
  bodyTemplate String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("email_templates")
}

model EmailLog {
  id            String      @id @default(uuid())
  weddingId     String
  wedding       Wedding     @relation(fields: [weddingId], references: [id])
  templateKey   String
  recipientEmail String
  subject       String
  sentAt        DateTime    @default(now())
  status        EmailStatus
  relatedTaskId String?
  relatedTask   Task?       @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)
  relatedPaymentId String?
  relatedPayment   Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: SetNull)

  @@map("email_logs")
}

// A single expected money movement for a wedding — either owed to us by the
// couple ("incoming") or owed by us to a vendor ("outgoing", optionally
// linked to which vendor). Wedding.budgetSpent/totalCollected are derived
// from these at read time rather than tracked as separate manual fields.
model Payment {
  id          String           @id @default(uuid())
  weddingId   String
  wedding     Wedding          @relation(fields: [weddingId], references: [id])
  vendorId    String?
  vendor      Vendor?          @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  direction   PaymentDirection
  description String
  amount      Decimal          @db.Decimal(12, 2)
  dueDate     DateTime
  paidDate    DateTime?
  status      PaymentStatus    @default(pending)
  method      String?
  notes       String?
  createdAt   DateTime         @default(now())

  emailLogs   EmailLog[]

  @@map("payments")
}
