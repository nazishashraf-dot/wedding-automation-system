// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  lead
  active
  completed
  archived
}

enum PlanningStatus {
  inquiry
  booked
  in_progress
  final_month
  completed
}

enum VendorCategory {
  florist
  caterer
  venue
  photographer
  dj_band
  hair_makeup
  other
}

enum VendorLinkStatus {
  contacted
  quoted
  confirmed
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskSource {
  auto_generated
  manual
}

model Client {
  id           String       @id @default(uuid())
  fullName     String
  partnerName  String?
  email        String
  phone        String?
  status       ClientStatus @default(lead)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  weddings     Wedding[]

  @@map("clients")
}

model Wedding {
  id              String         @id @default(uuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id])
  weddingDate     DateTime
  venue           String?
  budgetTotal     Decimal?       @db.Decimal(12, 2)
  budgetSpent     Decimal        @default(0) @db.Decimal(12, 2)
  planningStatus  PlanningStatus @default(inquiry)
  styleNotes      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  vendors         WeddingVendor[]
  tasks           Task[]

  @@map("weddings")
}

model Vendor {
  id           String         @id @default(uuid())
  name         String
  category     VendorCategory
  contactEmail String?
  phone        String?
  notes        String?
  createdAt    DateTime       @default(now())

  weddings     WeddingVendor[]

  @@map("vendors")
}

model WeddingVendor {
  weddingId    String
  wedding      Wedding           @relation(fields: [weddingId], references: [id])
  vendorId     String
  vendor       Vendor            @relation(fields: [vendorId], references: [id])
  status       VendorLinkStatus  @default(contacted)
  priceQuoted  Decimal?          @db.Decimal(12, 2)
  notes        String?

  @@id([weddingId, vendorId])
  @@map("wedding_vendors")
}

model Task {
  id              String        @id @default(uuid())
  weddingId       String
  wedding         Wedding       @relation(fields: [weddingId], references: [id])
  timelineRuleId  String?
  timelineRule    TimelineRule? @relation(fields: [timelineRuleId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  dueDate         DateTime
  status          TaskStatus    @default(todo)
  priority        TaskPriority  @default(medium)
  assignee        String?
  source          TaskSource    @default(manual)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("tasks")
}

// Configurable template of standard milestones. Editable without touching
// application code — this is what POST /weddings and the regenerate-timeline
// endpoint read from to auto-generate a wedding's task list.
model TimelineRule {
  id                  String       @id @default(uuid())
  label               String
  monthsBeforeWedding Int?
  weeksBeforeWedding  Int?
  taskTitle           String
  taskDescription     String?
  defaultPriority     TaskPriority @default(medium)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())

  tasks               Task[]

  @@map("timeline_rules")
}
