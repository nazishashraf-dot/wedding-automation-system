# Server-side only (no NEXT_PUBLIC_ prefix — the browser never sees this
# directly). next.config.mjs proxies /api/* requests to this origin, so
# every browser request to the API is same-origin as the frontend and the
# session cookie is first-party instead of getting blocked as third-party.
#
# Local dev:   http://localhost:4000
# Production:  your Railway API deployment URL, e.g. https://your-api.up.railway.app
API_ORIGIN=http://localhost:4000
