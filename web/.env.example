# The API's base URL. Used by src/lib/api.ts for every request from the
# browser — must be reachable from wherever this app is running (a browser
# on your machine in dev, or a visitor's browser in production), and must
# be prefixed NEXT_PUBLIC_ so Next.js exposes it client-side.
#
# Local dev:   http://localhost:4000
# Production:  your Railway API deployment URL, e.g. https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000
